{
  "name": "my-portfolio",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "prepare": "[ -d .git ] && lefthook install || echo 'skipping lefthook (no .git)'",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "astro build && wrangler deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@shikijs/transformers": "^4.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.4.1",
    "astro-og-canvas": "^0.11.1",
    "tailwindcss": "^4.3.0",
    "wrangler": "^4.95.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "lefthook": "^2.1.8",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
