---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '@/config';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const { hero, profile, stack, projects } = siteConfig.home;
---

<Layout>
  <section
    class="border-line relative flex min-h-[85vh] flex-col justify-center border-b px-6 md:px-16"
  >
    <div class="max-w-4xl">
      <p class="hero-text text-accent mb-4 font-mono text-sm tracking-widest uppercase">
        {hero.label}
      </p>

      <h1
        class="hero-text text-ink mb-8 text-5xl leading-[1.1] font-semibold tracking-tighter md:text-7xl lg:text-8xl"
      >
        <span set:html={hero.headline} /><span class="cursor-blink text-accent">_</span>
      </h1>

      <p class="hero-text text-ink-soft mb-12 max-w-2xl text-lg leading-relaxed">
        {hero.description}
      </p>

      <div class="hero-text flex w-full flex-col gap-0 sm:w-auto sm:flex-row sm:gap-6">
        <a
          href={hero.primaryBtn.href}
          class="bg-accent-fill text-on-accent hover:bg-accent-fill-hover group relative inline-flex items-center justify-center px-8 py-4 font-mono text-sm font-bold tracking-wider uppercase transition-colors"
        >
          {hero.primaryBtn.text}
        </a>
        <a
          href={hero.secondaryBtn.href}
          class="group border-line-strong bg-canvas text-ink hover:border-accent hover:text-accent inline-flex items-center justify-center border px-8 py-4 font-mono text-sm font-bold tracking-wider uppercase transition-colors"
        >
          {hero.secondaryBtn.text}
        </a>
      </div>
    </div>

    <div class="text-faint absolute right-8 bottom-8 hidden font-mono text-xs md:block">
      SCROLL_DOWN [↓]
    </div>
  </section>

  <section
    id="about"
    aria-label="About Me"
    class="gsap-section border-line grid scroll-mt-10 border-b md:grid-cols-12"
  >
    <div
      class="border-line bg-surface border-b px-6 py-12 md:col-span-3 md:border-r md:border-b-0 md:px-8"
    >
      <h2 class="text-muted sticky top-24 font-mono text-xs tracking-widest uppercase">
        01 — Profile
      </h2>
    </div>

    <div class="px-6 py-20 md:col-span-9 md:px-16">
      <h3 class="text-ink mb-8 text-3xl font-medium">{profile.heading}</h3>
      <div class="text-ink-soft space-y-6 text-lg leading-relaxed">
        {profile.content.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      {
        profile.stats && (
          <dl class="border-line mt-12 grid grid-cols-2 gap-8 border-t pt-12 md:grid-cols-4">
            {profile.stats.map((stat) => (
              <div>
                <dt class="sr-only">Statistic Value</dt>
                <dd class="text-ink mb-1 block text-3xl font-bold">{stat.value}</dd>
                <dt class="text-muted font-mono text-xs uppercase">{stat.label}</dt>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <section
    id="skills"
    aria-label="Tech Stack"
    class="gsap-section border-line grid scroll-mt-10 border-b md:grid-cols-12"
  >
    <div
      class="border-line bg-surface border-b px-6 py-12 md:col-span-3 md:border-r md:border-b-0 md:px-8"
    >
      <h2 class="text-muted sticky top-24 font-mono text-xs tracking-widest uppercase">
        02 — Stack
      </h2>
    </div>

    <div class="md:col-span-9">
      <div class="-mr-px -mb-px grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {
          stack.map((group) => (
            <div class="border-line bg-canvas h-full border-r border-b p-6 md:p-10">
              <h4 class="text-accent mb-6 font-mono text-sm font-bold uppercase">{group.title}</h4>
              <ul class="stagger-list text-ink-soft space-y-3 font-mono text-sm">
                {group.items.map((item) => (
                  <li class="flex items-center">
                    <span class="bg-line-strong mr-3 h-1.5 w-1.5" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="projects"
    aria-label="Selected Projects"
    class="gsap-section border-line grid scroll-mt-10 border-b md:grid-cols-12"
  >
    <div
      class="border-line bg-surface border-b px-6 py-12 md:col-span-3 md:border-r md:border-b-0 md:px-8"
    >
      <h2 class="text-muted sticky top-24 font-mono text-xs tracking-widest uppercase">
        03 — Projects
      </h2>
    </div>

    <div class="md:col-span-9">
      {
        projects.map((project) => (
          <article class="project-card group border-line hover:bg-surface-hover border-b transition-colors duration-150">
            <div class="flex flex-col gap-6 p-6 md:p-10">
              <div class="flex items-start justify-between">
                <h3 class="text-ink group-hover:text-accent-hover text-2xl font-medium transition-colors">
                  {project.title}
                </h3>
                {project.links ? (
                  <div class="flex gap-4" aria-label="Project links">
                    {project.links.map((link, i) => (
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`px-3 py-1 font-mono text-xs uppercase transition-colors ${i === 0 ? 'border-line-strong text-ink-soft hover:border-accent hover:text-accent border' : 'border-accent text-accent hover:bg-accent hover:text-on-accent border'}`}
                      >
                        {link.text}
                      </a>
                    ))}
                  </div>
                ) : (
                  project.link && (
                    <a
                      href={project.link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="border-accent text-accent hover:bg-accent hover:text-on-accent border px-3 py-1 font-mono text-xs uppercase transition-colors"
                    >
                      {project.link.text}
                    </a>
                  )
                )}
              </div>
              <p class="text-ink-soft max-w-2xl">{project.description}</p>
              <div
                class="text-muted flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs tracking-wider uppercase"
                aria-label="Technologies used"
              >
                {project.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section
    id="blog"
    aria-label="Recent Writing"
    class="gsap-section border-line grid scroll-mt-10 border-b md:grid-cols-12"
  >
    <div
      class="border-line bg-surface border-b px-6 py-12 md:col-span-3 md:border-r md:border-b-0 md:px-8"
    >
      <h2 class="text-muted sticky top-24 font-mono text-xs tracking-widest uppercase">
        04 — Writing
      </h2>
    </div>

    <div class="md:col-span-9">
      {
        recentPosts.map((post) => (
          <article class="blog-card group border-line hover:bg-surface-hover border-b transition-colors duration-150">
            <div class="flex flex-col gap-4 p-6 md:p-10">
              <div class="flex items-start justify-between">
                <h3 class="text-ink group-hover:text-accent-hover text-xl font-medium transition-colors">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h3>
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="text-muted font-mono text-xs tracking-wider uppercase"
                >
                  {post.data.pubDate.toLocaleDateString()}
                </time>
              </div>
              <p class="text-ink-soft line-clamp-2 max-w-2xl text-sm">{post.data.description}</p>
              <a
                href={`/blog/${post.id}`}
                class="text-accent hover:text-accent-hover mt-2 font-mono text-xs tracking-wider uppercase transition-colors"
                aria-label={`Read article: ${post.data.title}`}
              >
                Read Article →
              </a>
            </div>
          </article>
        ))
      }

      <div class="p-6 md:p-10">
        <a
          href="/blog"
          class="border-accent text-accent hover:bg-accent hover:text-on-accent inline-block border px-6 py-3 font-mono text-xs uppercase transition-colors"
        >
          View All Posts
        </a>
      </div>
    </div>
  </section>

  <section
    id="contact"
    aria-label="Contact Me"
    class="gsap-section scroll-mt-10 px-6 py-24 text-center md:px-16"
  >
    <h2 class="text-accent mb-6 font-mono text-sm font-bold tracking-widest uppercase">
      // Initialize Handshake
    </h2>
    <h3 class="text-ink mb-8 text-4xl font-semibold md:text-5xl">Ready to collaborate?</h3>
    <p class="text-ink-soft mx-auto mb-12 max-w-lg">
      Currently open for freelance contracts and full-time opportunities. If you need clean code and
      solid architecture, let's talk.
    </p>

    <div class="mx-auto inline-flex w-full max-w-xs flex-col gap-6">
      <a
        href={`mailto:${siteConfig.site.email}`}
        class="bg-accent-fill text-on-accent hover:bg-accent-fill-hover block w-full py-4 font-mono text-sm font-bold tracking-wider uppercase transition-colors"
      >
        Send Email
      </a>

      <nav
        aria-label="Social Media Links"
        class="text-muted flex justify-center gap-8 font-mono text-xs tracking-widest uppercase"
      >
        <a
          href={siteConfig.site.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-ink transition-colors">GitHub</a
        >
        <a
          href={siteConfig.site.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-ink transition-colors">LinkedIn</a
        >
        <a
          href={siteConfig.site.social.twitter}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-ink transition-colors">Twitter</a
        >
      </nav>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Hero Text Stagger
  gsap.from('.hero-text', {
    y: 30,
    opacity: 0,
    duration: 1,
    stagger: 0.15,
    ease: 'power3.out',
    delay: 0.5, // Wait for page fade in
  });

  // Section Reveals
  const sections = document.querySelectorAll('.gsap-section');
  sections.forEach((section) => {
    gsap.from(section, {
      scrollTrigger: {
        trigger: section,
        start: 'top 80%', // When top of section hits 80% of viewport
        once: true,
      },
      y: 50,
      opacity: 0,
      duration: 1,
      ease: 'power3.out',
    });
  });

  // Stagger Lists (Stack)
  const lists = document.querySelectorAll('.stagger-list');
  lists.forEach((list) => {
    const items = list.querySelectorAll('li');
    gsap.from(items, {
      scrollTrigger: {
        trigger: list,
        start: 'top 85%',
      },
      x: -20,
      opacity: 0,
      duration: 0.6,
      stagger: 0.1,
      ease: 'power2.out',
    });
  });

  // Project Cards Stagger
  // Assuming we want to animate them as they appear
  const projects = document.querySelectorAll('.project-card');
  projects.forEach((card) => {
    gsap.from(card, {
      scrollTrigger: {
        trigger: card,
        start: 'top 85%',
      },
      y: 30,
      opacity: 0,
      duration: 0.8,
      ease: 'power2.out',
    });
  });

  // Blog Cards Stagger
  const blogCards = document.querySelectorAll('.blog-card');
  blogCards.forEach((card) => {
    gsap.from(card, {
      scrollTrigger: {
        trigger: card,
        start: 'top 85%',
      },
      y: 30,
      opacity: 0,
      duration: 0.8,
      ease: 'power2.out',
    });
  });
</script>
