---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '@/config';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const { hero, profile, stack, projects } = siteConfig.home;
---

<Layout>
  <section
    class="relative flex min-h-[85vh] flex-col justify-center border-b border-neutral-800 px-6 md:px-16"
  >
    <div class="max-w-4xl">
      <p class="hero-text mb-4 font-mono text-sm tracking-widest text-emerald-500 uppercase">
        {hero.label}
      </p>

      <h1
        class="hero-text mb-8 text-5xl leading-[1.1] font-semibold tracking-tighter text-white md:text-7xl lg:text-8xl"
      >
        <span set:html={hero.headline} /><span class="cursor-blink text-emerald-500">_</span>
      </h1>

      <p class="hero-text mb-12 max-w-2xl text-lg leading-relaxed text-neutral-400">
        {hero.description}
      </p>

      <div class="hero-text flex w-full flex-col gap-0 sm:w-auto sm:flex-row sm:gap-6">
        <a
          href={hero.primaryBtn.href}
          class="group relative inline-flex items-center justify-center bg-emerald-600 px-8 py-4 font-mono text-sm font-bold tracking-wider text-black uppercase transition-colors hover:bg-emerald-500"
        >
          {hero.primaryBtn.text}
        </a>
        <a
          href={hero.secondaryBtn.href}
          class="group inline-flex items-center justify-center border border-neutral-700 bg-black px-8 py-4 font-mono text-sm font-bold tracking-wider text-white uppercase transition-colors hover:border-emerald-500 hover:text-emerald-500"
        >
          {hero.secondaryBtn.text}
        </a>
      </div>
    </div>

    <div class="absolute right-8 bottom-8 hidden font-mono text-xs text-neutral-600 md:block">
      SCROLL_DOWN [↓]
    </div>
  </section>

  <section
    id="about"
    aria-label="About Me"
    class="gsap-section grid scroll-mt-10 border-b border-neutral-800 md:grid-cols-12"
  >
    <div
      class="border-b border-neutral-800 bg-neutral-900/20 px-6 py-12 md:col-span-3 md:border-r md:border-b-0 md:px-8"
    >
      <h2 class="sticky top-24 font-mono text-xs tracking-widest text-neutral-500 uppercase">
        01 — Profile
      </h2>
    </div>

    <div class="px-6 py-20 md:col-span-9 md:px-16">
      <h3 class="mb-8 text-3xl font-medium text-white">{profile.heading}</h3>
      <div class="space-y-6 text-lg leading-relaxed text-neutral-400">
        {profile.content.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      {
        profile.stats && (
          <dl class="mt-12 grid grid-cols-2 gap-8 border-t border-neutral-800 pt-12 md:grid-cols-4">
            {profile.stats.map((stat) => (
              <div>
                <dt class="sr-only">Statistic Value</dt>
                <dd class="mb-1 block text-3xl font-bold text-white">{stat.value}</dd>
                <dt class="font-mono text-xs text-neutral-500 uppercase">{stat.label}</dt>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </section>

  <section
    id="skills"
    aria-label="Tech Stack"
    class="gsap-section grid scroll-mt-10 border-b border-neutral-800 md:grid-cols-12"
  >
    <div
      class="border-b border-neutral-800 bg-neutral-900/20 px-6 py-12 md:col-span-3 md:border-r md:border-b-0 md:px-8"
    >
      <h2 class="sticky top-24 font-mono text-xs tracking-widest text-neutral-500 uppercase">
        02 — Stack
      </h2>
    </div>

    <div class="md:col-span-9">
      <div class="-mr-px -mb-px grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {
          stack.map((group) => (
            <div class="h-full border-r border-b border-neutral-800 bg-black p-6 md:p-10">
              <h4 class="mb-6 font-mono text-sm font-bold text-emerald-500 uppercase">
                {group.title}
              </h4>
              <ul class="stagger-list space-y-3 font-mono text-sm text-neutral-400">
                {group.items.map((item) => (
                  <li class="flex items-center">
                    <span class="mr-3 h-1.5 w-1.5 bg-neutral-700" aria-hidden="true" />
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="projects"
    aria-label="Selected Projects"
    class="gsap-section grid scroll-mt-10 border-b border-neutral-800 md:grid-cols-12"
  >
    <div
      class="border-b border-neutral-800 bg-neutral-900/20 px-6 py-12 md:col-span-3 md:border-r md:border-b-0 md:px-8"
    >
      <h2 class="sticky top-24 font-mono text-xs tracking-widest text-neutral-500 uppercase">
        03 — Projects
      </h2>
    </div>

    <div class="md:col-span-9">
      {
        projects.map((project) => (
          <article class="project-card group border-b border-neutral-800 transition-colors duration-150 hover:bg-neutral-900/30">
            <div class="flex flex-col gap-6 p-6 md:p-10">
              <div class="flex items-start justify-between">
                <h3 class="text-2xl font-medium text-white transition-colors group-hover:text-emerald-400">
                  {project.title}
                </h3>
                {project.links ? (
                  <div class="flex gap-4" aria-label="Project links">
                    {project.links.map((link, i) => (
                      <a
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`px-3 py-1 font-mono text-xs uppercase transition-colors ${i === 0 ? 'border border-neutral-700 text-neutral-400 hover:border-emerald-500 hover:text-emerald-500' : 'border border-emerald-500 text-emerald-500 hover:bg-emerald-500 hover:text-black'}`}
                      >
                        {link.text}
                      </a>
                    ))}
                  </div>
                ) : (
                  project.link && (
                    <a
                      href={project.link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="border border-emerald-500 px-3 py-1 font-mono text-xs text-emerald-500 uppercase transition-colors hover:bg-emerald-500 hover:text-black"
                    >
                      {project.link.text}
                    </a>
                  )
                )}
              </div>
              <p class="max-w-2xl text-neutral-400">{project.description}</p>
              <div
                class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs tracking-wider text-neutral-500 uppercase"
                aria-label="Technologies used"
              >
                {project.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section
    id="blog"
    aria-label="Recent Writing"
    class="gsap-section grid scroll-mt-10 border-b border-neutral-800 md:grid-cols-12"
  >
    <div
      class="border-b border-neutral-800 bg-neutral-900/20 px-6 py-12 md:col-span-3 md:border-r md:border-b-0 md:px-8"
    >
      <h2 class="sticky top-24 font-mono text-xs tracking-widest text-neutral-500 uppercase">
        04 — Writing
      </h2>
    </div>

    <div class="md:col-span-9">
      {
        recentPosts.map((post) => (
          <article class="blog-card group border-b border-neutral-800 transition-colors duration-150 hover:bg-neutral-900/30">
            <div class="flex flex-col gap-4 p-6 md:p-10">
              <div class="flex items-start justify-between">
                <h3 class="text-xl font-medium text-white transition-colors group-hover:text-emerald-400">
                  <a href={`/blog/${post.id}`}>{post.data.title}</a>
                </h3>
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="font-mono text-xs tracking-wider text-neutral-500 uppercase"
                >
                  {post.data.pubDate.toLocaleDateString()}
                </time>
              </div>
              <p class="line-clamp-2 max-w-2xl text-sm text-neutral-400">{post.data.description}</p>
              <a
                href={`/blog/${post.id}`}
                class="mt-2 font-mono text-xs tracking-wider text-emerald-500 uppercase transition-colors hover:text-emerald-400"
                aria-label={`Read article: ${post.data.title}`}
              >
                Read Article →
              </a>
            </div>
          </article>
        ))
      }

      <div class="p-6 md:p-10">
        <a
          href="/blog"
          class="inline-block border border-emerald-500 px-6 py-3 font-mono text-xs text-emerald-500 uppercase transition-colors hover:bg-emerald-500 hover:text-black"
        >
          View All Posts
        </a>
      </div>
    </div>
  </section>

  <section
    id="contact"
    aria-label="Contact Me"
    class="gsap-section scroll-mt-10 px-6 py-24 text-center md:px-16"
  >
    <h2 class="mb-6 font-mono text-sm font-bold tracking-widest text-emerald-500 uppercase">
      // Initialize Handshake
    </h2>
    <h3 class="mb-8 text-4xl font-semibold text-white md:text-5xl">Ready to collaborate?</h3>
    <p class="mx-auto mb-12 max-w-lg text-neutral-400">
      Currently open for freelance contracts and full-time opportunities. If you need clean code and
      solid architecture, let's talk.
    </p>

    <div class="mx-auto inline-flex w-full max-w-xs flex-col gap-6">
      <a
        href={`mailto:${siteConfig.site.email}`}
        class="block w-full bg-emerald-600 py-4 font-mono text-sm font-bold tracking-wider text-black uppercase transition-colors hover:bg-emerald-500"
      >
        Send Email
      </a>

      <nav
        aria-label="Social Media Links"
        class="flex justify-center gap-8 font-mono text-xs tracking-widest text-neutral-500 uppercase"
      >
        <a
          href={siteConfig.site.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white">GitHub</a
        >
        <a
          href={siteConfig.site.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white">LinkedIn</a
        >
        <a
          href={siteConfig.site.social.twitter}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-colors hover:text-white">Twitter</a
        >
      </nav>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Hero Text Stagger
  gsap.from('.hero-text', {
    y: 30,
    opacity: 0,
    duration: 1,
    stagger: 0.15,
    ease: 'power3.out',
    delay: 0.5, // Wait for page fade in
  });

  // Section Reveals
  const sections = document.querySelectorAll('.gsap-section');
  sections.forEach((section) => {
    gsap.from(section, {
      scrollTrigger: {
        trigger: section,
        start: 'top 80%', // When top of section hits 80% of viewport
        toggleActions: 'play none none reverse',
      },
      y: 50,
      opacity: 0,
      duration: 1,
      ease: 'power3.out',
    });
  });

  // Stagger Lists (Stack)
  const lists = document.querySelectorAll('.stagger-list');
  lists.forEach((list) => {
    const items = list.querySelectorAll('li');
    gsap.from(items, {
      scrollTrigger: {
        trigger: list,
        start: 'top 85%',
      },
      x: -20,
      opacity: 0,
      duration: 0.6,
      stagger: 0.1,
      ease: 'power2.out',
    });
  });

  // Project Cards Stagger
  // Assuming we want to animate them as they appear
  const projects = document.querySelectorAll('.project-card');
  projects.forEach((card) => {
    gsap.from(card, {
      scrollTrigger: {
        trigger: card,
        start: 'top 85%',
      },
      y: 30,
      opacity: 0,
      duration: 0.8,
      ease: 'power2.out',
    });
  });

  // Blog Cards Stagger
  const blogCards = document.querySelectorAll('.blog-card');
  blogCards.forEach((card) => {
    gsap.from(card, {
      scrollTrigger: {
        trigger: card,
        start: 'top 85%',
      },
      y: 30,
      opacity: 0,
      duration: 0.8,
      ease: 'power2.out',
    });
  });
</script>
