---
import Layout from '../layouts/Layout.astro';
import PostRow from '@/components/PostRow.astro';
import { siteConfig } from '@/config';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const { hero, profile, stack, projects, contact } = siteConfig.home;
---

<Layout>
  <!-- Hero -->
  <section
    class="mx-auto flex min-h-[88vh] max-w-6xl flex-col justify-center px-6 py-24 md:px-10 lg:px-16"
  >
    <p class="enter text-muted font-mono text-xs tracking-[0.14em] uppercase" style="--i:0">
      {hero.label}
    </p>

    <h1 class="enter text-ink text-display mt-8 font-serif" style="--i:1">
      {hero.headline.map((line) => <span class="block">{line}</span>)}
    </h1>

    <p
      class="enter text-ink-soft mt-10 max-w-[38ch] text-xl leading-relaxed md:text-2xl"
      style="--i:2"
    >
      {hero.description}
    </p>

    <div
      class="enter mt-14 flex flex-col items-start gap-6 sm:flex-row sm:items-center sm:gap-10"
      style="--i:3"
    >
      <a
        href={hero.primaryBtn.href}
        class="bg-accent-fill text-on-accent hover:bg-accent-fill-hover px-7 py-3.5 text-sm font-medium transition-colors"
      >
        {hero.primaryBtn.text}
      </a>
      <a
        href={hero.secondaryBtn.href}
        class="text-ink decoration-line-strong hover:decoration-accent text-sm font-medium underline decoration-1 underline-offset-[6px] transition-colors"
      >
        {hero.secondaryBtn.text}
      </a>
    </div>
  </section>

  <!-- 01 — Profile -->
  <section id="about" aria-label="About me" class="border-line scroll-mt-20 border-t">
    <div
      class="mx-auto grid max-w-6xl gap-y-10 px-6 py-24 md:grid-cols-12 md:gap-x-10 md:px-10 md:py-32 lg:px-16"
    >
      <div class="md:col-span-3">
        <h2 class="text-muted font-mono text-xs tracking-[0.14em] uppercase md:sticky md:top-24">
          01 / Profile
        </h2>
      </div>

      <div class="reveal md:col-span-8 md:col-start-5">
        <p class="text-ink text-headline font-serif">{profile.heading}</p>
        <div class="text-ink-soft mt-10 max-w-[68ch] space-y-6 text-lg leading-[1.7]">
          {profile.content.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- 02 — Stack -->
  <section id="skills" aria-label="Tech stack" class="border-line scroll-mt-20 border-t">
    <div
      class="mx-auto grid max-w-6xl gap-y-10 px-6 py-24 md:grid-cols-12 md:gap-x-10 md:px-10 md:py-32 lg:px-16"
    >
      <div class="md:col-span-3">
        <h2 class="text-muted font-mono text-xs tracking-[0.14em] uppercase md:sticky md:top-24">
          02 / Stack
        </h2>
      </div>

      <div class="md:col-span-9 md:col-start-4">
        <dl>
          {
            stack.map((group) => (
              <div class="reveal border-line grid gap-y-4 border-t py-8 first:border-t-0 first:pt-0 md:grid-cols-9 md:gap-x-10">
                <dt class="text-ink font-serif text-2xl md:col-span-3">{group.title}</dt>
                <dd class="md:col-span-6">
                  <ul class="text-ink-soft flex flex-wrap text-lg">
                    {group.items.map((item) => (
                      <li class="before:text-line-strong before:mx-3 before:content-['·'] first:before:hidden">
                        {item}
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <!-- 03 — Selected work -->
  <section id="projects" aria-label="Selected projects" class="border-line scroll-mt-20 border-t">
    <div class="mx-auto max-w-6xl px-6 py-24 md:px-10 md:py-32 lg:px-16">
      <h2 class="text-muted font-mono text-xs tracking-[0.14em] uppercase">03 / Selected work</h2>

      <ol class="mt-14">
        {
          projects.map((project, i) => {
            const links = project.links ?? (project.link ? [project.link] : []);
            return (
              <li class="reveal border-line hover:border-line-strong group border-t transition-colors">
                <article class="grid gap-y-6 py-10 md:grid-cols-12 md:gap-x-10 md:py-14">
                  <div class="md:col-span-2">
                    <span class="text-line-strong font-serif text-5xl leading-none">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                  </div>

                  <div class="md:col-span-10">
                    <h3 class="text-ink group-hover:text-accent font-serif text-3xl transition-colors md:text-4xl">
                      {project.title}
                    </h3>

                    <p class="text-ink-soft mt-5 max-w-[62ch] text-lg leading-[1.7]">
                      {project.description}
                    </p>

                    <ul
                      class="text-muted mt-7 flex flex-wrap font-mono text-xs tracking-[0.14em] uppercase"
                      aria-label="Technologies used"
                    >
                      {project.tags.map((tag) => (
                        <li class="before:text-line-strong before:mx-3 before:content-['·'] first:before:hidden">
                          {tag}
                        </li>
                      ))}
                    </ul>

                    {links.length > 0 && (
                      <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3" aria-label="Project links">
                        {links.map((link) => (
                          <a
                            href={link.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-accent hover:text-accent-hover decoration-line-strong hover:decoration-accent text-sm font-medium underline decoration-1 underline-offset-[6px] transition-colors"
                          >
                            {link.text}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </article>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>

  <!-- 04 — Writing -->
  <section id="blog" aria-label="Recent writing" class="border-line scroll-mt-20 border-t">
    <div class="mx-auto max-w-6xl px-6 py-24 md:px-10 md:py-32 lg:px-16">
      <h2 class="text-muted font-mono text-xs tracking-[0.14em] uppercase">04 / Writing</h2>

      <ul class="mt-14">
        {
          recentPosts.map((post) => (
            <PostRow
              href={`/blog/${post.id}`}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
            />
          ))
        }
      </ul>

      <a
        href="/blog"
        class="text-accent hover:text-accent-hover decoration-line-strong hover:decoration-accent mt-12 inline-block text-sm font-medium underline decoration-1 underline-offset-[6px] transition-colors"
      >
        All writing
      </a>
    </div>
  </section>

  <!-- 05 — Contact -->
  <section id="contact" aria-label="Contact me" class="border-line scroll-mt-20 border-t">
    <div
      class="mx-auto grid max-w-6xl gap-y-10 px-6 py-24 md:grid-cols-12 md:gap-x-10 md:px-10 md:py-32 lg:px-16"
    >
      <div class="md:col-span-3">
        <h2 class="text-muted font-mono text-xs tracking-[0.14em] uppercase md:sticky md:top-24">
          05 / {contact.label}
        </h2>
      </div>

      <div class="reveal md:col-span-7 md:col-start-4">
        <p class="text-ink text-headline font-serif">{contact.heading}</p>
        <p class="text-ink-soft mt-8 max-w-[52ch] text-lg leading-[1.7]">{contact.description}</p>

        <a
          href={`mailto:${siteConfig.site.email}`}
          class="text-accent hover:text-accent-hover decoration-line-strong hover:decoration-accent mt-10 inline-block font-serif text-3xl underline decoration-1 underline-offset-[8px] transition-colors md:text-4xl"
        >
          {siteConfig.site.email}
        </a>

        <nav
          aria-label="Social links"
          class="text-muted mt-14 flex flex-wrap gap-x-8 gap-y-3 font-mono text-xs tracking-[0.14em] uppercase"
        >
          <a
            href={siteConfig.site.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-ink transition-colors">GitHub</a
          >
          <a
            href={siteConfig.site.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-ink transition-colors">LinkedIn</a
          >
          <a
            href={siteConfig.site.social.twitter}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-ink transition-colors">Twitter</a
          >
        </nav>
      </div>
    </div>
  </section>
</Layout>
