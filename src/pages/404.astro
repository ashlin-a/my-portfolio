---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found">
  <section
    class="mx-auto flex min-h-[80vh] max-w-6xl flex-col justify-center px-6 md:px-10 lg:px-16"
  >
    <p class="enter text-muted font-mono text-xs tracking-[0.14em] uppercase" style="--i:0">
      Error 404
    </p>

    <p class="enter text-line-strong text-display mt-8 font-serif select-none" style="--i:1">404</p>

    <div class="enter border-line mt-8 border-t pt-8" style="--i:2">
      <p class="text-ink max-w-[38ch] font-serif text-3xl md:text-4xl">This page doesn’t exist.</p>
      <p class="text-ink-soft mt-6 max-w-[52ch] text-lg leading-[1.7]">
        The address may be mistyped, or the page has moved since you last saw it.
      </p>

      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
        <a
          href="/"
          class="text-accent hover:text-accent-hover decoration-line-strong hover:decoration-accent text-sm font-medium underline decoration-1 underline-offset-[6px] transition-colors"
        >
          Back to home
        </a>
        <a
          href="/blog"
          class="text-accent hover:text-accent-hover decoration-line-strong hover:decoration-accent text-sm font-medium underline decoration-1 underline-offset-[6px] transition-colors"
        >
          Read the writing
        </a>
      </div>
    </div>
  </section>
</Layout>
