---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 | Page Not Found">
  <section
    class="relative flex min-h-[80vh] flex-col items-center justify-center overflow-hidden px-6 text-center"
  >
    <!-- Background decorative elements -->
    <div
      class="pointer-events-none absolute top-1/2 left-1/2 -z-10 h-[500px] w-[500px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-emerald-500/5 blur-3xl"
    >
    </div>

    <h1
      id="error-code"
      class="mb-4 bg-gradient-to-b from-neutral-200 to-neutral-800 bg-clip-text font-mono text-9xl font-bold tracking-tighter text-transparent select-none md:text-[12rem]"
    >
      404
    </h1>

    <div
      id="console-output"
      class="mb-10 w-full max-w-md rounded-lg border border-neutral-800 bg-neutral-900/50 p-6 text-left font-mono text-sm text-neutral-400 shadow-2xl backdrop-blur-sm md:text-base"
    >
      <p class="mb-2 text-red-500">➜ Error: Object not found</p>
      <p class="mb-1">
        <span class="text-emerald-500">user@portfolio:~$</span> ping {Astro.url.pathname}
      </p>
      <p class="mb-4">Request timed out.</p>

      <p class="mb-1"><span class="text-emerald-500">user@portfolio:~$</span> whereis page</p>
      <p class="mb-4">page: (nowhere)</p>

      <p class="mb-1"><span class="text-emerald-500">user@portfolio:~$</span> cat excuse.txt</p>
      <p class="text-neutral-500 italic">"It works on my machine ¯\_(ツ)_/¯"</p>
    </div>

    <a
      href="/"
      id="home-btn"
      class="group relative inline-flex items-center justify-center bg-emerald-600 px-8 py-4 font-mono text-sm font-bold tracking-wider text-black uppercase transition-colors hover:bg-emerald-500"
    >
      <span>Return to Base</span>
    </a>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';

  const tl = gsap.timeline();

  tl.from('#error-code', {
    y: -50,
    opacity: 0,
    duration: 1,
    ease: 'bounce.out',
  })
    .from(
      '#console-output',
      {
        scale: 0.9,
        opacity: 0,
        duration: 0.5,
        ease: 'back.out(1.7)',
      },
      '-=0.5'
    )
    .from('#console-output p', {
      x: -10,
      opacity: 0,
      duration: 0.3,
      stagger: 0.1,
      ease: 'power2.out',
    })
    .from(
      '#home-btn',
      {
        y: 20,
        opacity: 0,
        duration: 0.5,
        ease: 'power2.out',
      },
      '-=0.2'
    );
</script>
