---
import Layout from '../../layouts/Layout.astro';
import PostRow from '@/components/PostRow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Writing"
  description="Articles on self-hosting, homelab, Docker, and web development by Ashlin Asokan."
>
  <!-- Header. Same full-bleed statement + offset lede as the home hero. -->
  <section class="mx-auto max-w-6xl px-6 pt-28 pb-16 md:px-10 md:pt-40 md:pb-24 lg:px-16">
    <p class="enter meta text-muted" style="--i:0">Index</p>

    <h1 class="enter text-ink text-display mt-6 font-serif" style="--i:1">Writing</h1>

    <div class="mt-12 grid md:grid-cols-12 md:gap-x-10">
      <p class="enter text-ink-soft text-lede md:col-span-6 md:col-start-7" style="--i:2">
        A collection of notes, ideas, and things I felt like sharing.
      </p>
    </div>
  </section>

  <!-- Posts -->
  <section aria-label="All posts" class="border-line border-t">
    <div class="mx-auto max-w-6xl px-6 py-16 md:px-10 md:py-20 lg:px-16">
      <p class="meta text-muted">
        {posts.length}
        {posts.length === 1 ? 'post' : 'posts'}
      </p>

      {
        posts.length > 0 ? (
          <ul class="mt-10 md:mt-12">
            {posts.map((post) => (
              <PostRow
                href={`/blog/${post.id}`}
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
              />
            ))}
          </ul>
        ) : (
          <p class="text-ink-soft text-body mt-10">No posts yet.</p>
        )
      }
    </div>
  </section>
</Layout>
