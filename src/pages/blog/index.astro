---
import Layout from '../../layouts/Layout.astro';
import PostRow from '@/components/PostRow.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Writing"
  description="Articles on self-hosting, homelab, Docker, and web development by Ashlin Asokan."
>
  <!-- Header -->
  <section class="mx-auto max-w-6xl px-6 pt-32 pb-20 md:px-10 md:pt-40 md:pb-24 lg:px-16">
    <p class="enter text-muted font-mono text-xs tracking-[0.14em] uppercase" style="--i:0">
      Index
    </p>

    <h1 class="enter text-ink text-display mt-8 font-serif" style="--i:1">Writing</h1>

    <p
      class="enter text-ink-soft mt-10 max-w-[42ch] text-xl leading-relaxed md:text-2xl"
      style="--i:2"
    >
      My personal knowledge base. I write about what I’m building, what broke along the way, and how
      I fixed it.
    </p>
  </section>

  <!-- Posts -->
  <section aria-label="All posts" class="border-line border-t">
    <div
      class="mx-auto grid max-w-6xl gap-y-10 px-6 py-20 md:grid-cols-12 md:gap-x-10 md:px-10 md:py-24 lg:px-16"
    >
      <div class="md:col-span-3">
        <h2 class="text-muted font-mono text-xs tracking-[0.14em] uppercase md:sticky md:top-24">
          All posts
        </h2>
      </div>

      <div class="md:col-span-9 md:col-start-4">
        {
          posts.length > 0 ? (
            <ul>
              {posts.map((post) => (
                <PostRow
                  href={`/blog/${post.id}`}
                  title={post.data.title}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                />
              ))}
            </ul>
          ) : (
            <p class="text-muted text-lg">No posts yet.</p>
          )
        }
      </div>
    </div>
  </section>
</Layout>
