---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout
  title="Writing"
  description="Articles on self-hosting, homelab, Docker, and web development by Ashlin Asokan."
>
  <!-- Header Section -->
  <section class="border-b border-neutral-800 px-6 pt-32 pb-16 md:px-16">
    <div class="max-w-4xl">
      <p class="header-animate mb-4 font-mono text-sm tracking-widest text-emerald-500 uppercase">
        // Index
      </p>

      <h1
        class="header-animate mb-8 text-5xl font-semibold tracking-tighter text-white md:text-7xl"
      >
        Writing<span class="text-emerald-500">_</span>
      </h1>

      <p class="header-animate max-w-2xl text-lg leading-relaxed text-neutral-400">
        My personal knowledge base. I write about what I’m building, what broke along the way, and
        how I fixed it.
      </p>
    </div>
  </section>

  <!-- Content Section -->
  <section class="grid border-b border-neutral-800 md:grid-cols-12">
    <div
      class="border-b border-neutral-800 bg-neutral-900/20 px-6 py-12 md:col-span-3 md:border-r md:border-b-0 md:px-8"
    >
      <h2 class="sticky top-24 font-mono text-xs tracking-widest text-neutral-500 uppercase">
        All Posts
      </h2>
    </div>

    <div class="md:col-span-9">
      <ul class="flex flex-col">
        {
          posts.map((post) => (
            <li class="blog-card group border-b border-neutral-800 transition-colors duration-150 hover:bg-neutral-900/30">
              <article class="flex flex-col gap-6 p-6 md:p-10">
                <div class="flex items-start justify-between">
                  <h3 class="text-2xl font-medium text-white transition-colors group-hover:text-emerald-400">
                    <a href={`/blog/${post.id}`}>{post.data.title}</a>
                  </h3>
                  <a
                    href={`/blog/${post.id}`}
                    class="border border-emerald-500 px-3 py-1 font-mono text-xs text-emerald-500 uppercase transition-colors hover:bg-emerald-500 hover:text-black"
                    aria-label={`Read ${post.data.title}`}
                  >
                    Read Post
                  </a>
                </div>
                {post.data.description && (
                  <p class="max-w-2xl text-neutral-400">{post.data.description}</p>
                )}
                <div class="flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs tracking-wider text-neutral-500 uppercase">
                  <time datetime={new Date(post.data.pubDate || Date.now()).toISOString()}>
                    [ {new Date(post.data.pubDate || Date.now()).toLocaleDateString()} ]
                  </time>
                </div>
              </article>
            </li>
          ))
        }
      </ul>

      {posts.length === 0 && <div class="p-12 font-mono text-neutral-500">// No posts found.</div>}
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Header Animation
  gsap.from('.header-animate', {
    y: 20,
    opacity: 0,
    duration: 0.8,
    stagger: 0.15,
    ease: 'power3.out',
    delay: 0.2,
  });

  // Blog Cards Animation
  const cards = document.querySelectorAll('.blog-card');
  cards.forEach((card) => {
    gsap.from(card, {
      scrollTrigger: {
        trigger: card,
        start: 'top 90%',
        toggleActions: 'play none none reverse',
      },
      y: 30,
      opacity: 0,
      duration: 0.8,
      ease: 'power2.out',
    });
  });
</script>
