---
import '../styles/global.css';
import { siteConfig } from '@/config';
import Seo from '@/components/Seo.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  article?: { publishedTime: Date; modifiedTime?: Date };
}

const { title, description, image, ogType, article } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Theme init. Must be inline + in <head> so `.dark` lands before first
         paint; the page script below is a module and runs too late. -->
    <meta name="theme-color" content="#fbfaf7" />
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {
          /* storage unavailable — fall through to the OS preference */
        }
        const dark = stored
          ? stored === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', dark ? '#0e0d0b' : '#fbfaf7');
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} image={image} ogType={ogType} article={article} />
  </head>
  <body class="bg-canvas text-ink-soft selection:bg-selection selection:text-ink antialiased">
    <a
      href="#main-content"
      class="focus:bg-accent-fill focus:text-on-accent sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-60 focus:px-4 focus:py-2 focus:text-sm focus:font-medium"
    >
      Skip to main content
    </a>

    <nav
      aria-label="Main Navigation"
      class="border-line bg-canvas/90 fixed top-0 z-50 w-full border-b backdrop-blur-sm"
    >
      <div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6 md:px-10 lg:px-16">
        <a
          href="/"
          class="text-ink hover:text-accent relative z-50 font-serif text-xl transition-colors"
          aria-label={`${siteConfig.site.name} — home`}
        >
          {siteConfig.site.name}
        </a>

        <div class="flex items-center gap-6 md:gap-10">
          <!-- Desktop Menu -->
          <ul class="text-muted hidden items-center gap-8 text-sm md:flex">
            {
              siteConfig.navigation.main.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="hover:text-ink decoration-line-strong hover:decoration-accent underline decoration-1 underline-offset-[6px] transition-colors"
                  >
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>

          <ThemeToggle />

          <!-- Mobile Toggle. `popovertarget` gives us open/close, Escape and
               light-dismiss for free, and sets aria-expanded implicitly. -->
          <button
            id="menu-toggle"
            type="button"
            popovertarget="mobile-menu"
            class="group relative z-50 flex h-8 w-8 flex-col items-end justify-center gap-1.5 md:hidden"
            aria-label="Toggle menu"
          >
            <span id="line-1" class="bg-ink h-0.5 w-6"></span>
            <span id="line-2" class="bg-accent h-0.5 w-4 group-hover:w-6"></span>
          </button>
        </div>
      </div>
    </nav>

    <!-- Mobile Menu Overlay. Sizing/animation live in global.css, since a
         popover renders in the top layer and needs UA styles overridden. -->
    <div id="mobile-menu" popover aria-label="Site menu">
      <ul
        class="text-ink flex h-full flex-col items-center justify-center gap-8 font-serif text-4xl"
      >
        {
          siteConfig.navigation.main.map((item, i) => (
            <li class="menu-link" style={`--i:${i}`}>
              <a href={item.href} class="hover:text-accent block transition-colors">
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <main id="main-content" class="mt-14 min-h-screen">
      <slot />
    </main>

    <footer
      role="contentinfo"
      class="border-line meta text-muted mx-auto flex max-w-6xl flex-col gap-2 border-t px-6 py-10 sm:flex-row sm:items-center sm:justify-between md:px-10 lg:px-16"
    >
      <div>© {new Date().getFullYear()} {siteConfig.site.name}</div>
      <div>Set in Instrument Serif &amp; Inter</div>
    </footer>

    <script>
      // The popover handles open/close, Escape and light-dismiss on its own.
      // Two cases it can't: same-page anchors (`/#projects`) don't dismiss it,
      // and crossing to the desktop breakpoint (phone rotated to landscape)
      // hides the burger, which would leave no way to close the overlay.
      const menu = document.getElementById('mobile-menu');

      // hidePopover() throws if the popover isn't currently showing.
      const close = () => {
        if (menu?.matches(':popover-open')) menu.hidePopover();
      };

      menu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', close);
      });

      matchMedia('(min-width: 48rem)').addEventListener('change', (e) => {
        if (e.matches) close();
      });
    </script>
  </body>
</html>
