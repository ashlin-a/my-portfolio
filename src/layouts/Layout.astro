---
import '../styles/global.css';
import { siteConfig } from '@/config';
import Seo from '@/components/Seo.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  article?: { publishedTime: Date; modifiedTime?: Date };
}

const { title, description, image, ogType, article } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Theme init. Must be inline + in <head> so `.dark` lands before first
         paint; the page script below is a module and runs too late. -->
    <meta name="theme-color" content="#000000" />
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {
          /* storage unavailable — fall through to the OS preference */
        }
        const dark = stored
          ? stored === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', dark ? '#000000' : '#ffffff');
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} image={image} ogType={ogType} article={article} />
  </head>
  <body
    class="bg-canvas text-ink-soft selection:bg-selection selection:text-ink overflow-x-hidden antialiased opacity-0"
  >
    <a
      href="#main-content"
      class="focus:bg-accent-fill focus:text-on-accent sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-60 focus:px-4 focus:py-2 focus:font-mono focus:font-bold"
    >
      Skip to main content
    </a>

    <nav
      aria-label="Main Navigation"
      class="border-line bg-canvas/90 fixed top-0 z-50 w-full border-b backdrop-blur-sm"
    >
      <div class="mx-auto flex h-14 max-w-7xl items-center justify-between px-6 md:px-8">
        <a
          href="/"
          class="text-ink relative z-50 font-mono text-sm font-bold tracking-tight"
          aria-label="{siteConfig.site.name} Home"
        >
          <span class="text-accent mr-2" aria-hidden="true">➜</span>{siteConfig.site.name}
        </a>

        <!-- Right cluster: keeping the desktop links inside this group preserves
             the original right-aligned layout, and leaves `nav ul.hidden li`
             (the GSAP stagger selector) intact. -->
        <div class="flex items-center gap-6 md:gap-10">
          <!-- Desktop Menu -->
          <ul
            class="text-muted hidden gap-6 font-mono text-xs tracking-widest uppercase md:flex md:gap-10"
          >
            {
              siteConfig.navigation.main.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="hover:text-accent-hover transition-colors duration-200"
                  >
                    {item.name}
                  </a>
                </li>
              ))
            }
          </ul>

          <ThemeToggle />

          <!-- Mobile Toggle -->
          <button
            id="menu-toggle"
            class="group relative z-50 flex h-8 w-8 flex-col items-end justify-center gap-1.5 md:hidden"
            aria-label="Toggle Menu"
          >
            <span id="line-1" class="bg-ink h-0.5 w-6 transition-all duration-300"></span>
            <span
              id="line-2"
              class="bg-accent h-0.5 w-4 transition-all duration-300 group-hover:w-6"></span>
          </button>
        </div>
      </div>
    </nav>

    <!-- Mobile Menu Overlay -->
    <div
      id="mobile-menu"
      class="bg-canvas pointer-events-none fixed inset-0 z-40 flex items-center justify-center opacity-0"
    >
      <ul
        class="text-muted flex flex-col items-center gap-8 font-mono text-2xl tracking-widest uppercase"
      >
        {
          siteConfig.navigation.main.map((item) => (
            <li class="mobile-link overflow-hidden">
              <a
                href={item.href}
                class="hover:text-accent block translate-y-full transition-colors"
              >
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <main
      id="main-content"
      class="border-line mx-auto mt-14 min-h-screen max-w-7xl border-r border-l"
    >
      <slot />
    </main>

    <footer
      role="contentinfo"
      class="border-line text-faint mx-auto flex max-w-7xl items-center justify-between border-t px-6 py-8 font-mono text-xs"
    >
      <div>© {new Date().getFullYear()} {siteConfig.site.name}</div>
      <div>NO_TRACKING_COOKIES</div>
    </footer>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // --- Mobile Menu Logic ---
      const toggleBtn = document.getElementById('menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileLinkAnchors = document.querySelectorAll('.mobile-link a');
      const line1 = document.getElementById('line-1');
      const line2 = document.getElementById('line-2');

      let isMenuOpen = false;

      // GSAP writes inline styles, which beat any class — so read the current
      // theme token at animation time rather than hardcoding a hex.
      const readVar = (name: string) =>
        getComputedStyle(document.documentElement).getPropertyValue(name).trim();

      function toggleMenu() {
        isMenuOpen = !isMenuOpen;

        if (isMenuOpen) {
          // Open
          document.body.style.overflow = 'hidden'; // Lock scroll

          gsap.to(mobileMenu, { opacity: 1, pointerEvents: 'auto', duration: 0.4 });
          gsap.to(mobileLinkAnchors, {
            y: 0,
            duration: 0.5,
            stagger: 0.1,
            delay: 0.1,
            ease: 'power3.out',
          });

          // Animate Burger to X
          gsap.to(line1, { rotation: 45, y: 4, duration: 0.3 });
          gsap.to(line2, {
            rotation: -45,
            y: -4,
            width: '1.5rem',
            backgroundColor: readVar('--color-ink'),
            duration: 0.3,
          });
        } else {
          // Close
          document.body.style.overflow = ''; // Unlock scroll

          gsap.to(mobileMenu, { opacity: 0, pointerEvents: 'none', duration: 0.4 });
          gsap.to(mobileLinkAnchors, { y: '100%', duration: 0.3 });

          // Animate X back to Burger
          gsap.to(line1, { rotation: 0, y: 0, duration: 0.3 });
          gsap.to(line2, {
            rotation: 0,
            y: 0,
            width: '1rem',
            backgroundColor: readVar('--color-accent'),
            duration: 0.3,
            // Hand control back to the classes, so switching theme while the
            // menu was open doesn't leave a stale inline color behind.
            onComplete: () => gsap.set([line1, line2], { clearProps: 'backgroundColor' }),
          });
        }
      }

      toggleBtn?.addEventListener('click', toggleMenu);

      // Close menu when a link is clicked
      mobileLinkAnchors.forEach((link) => {
        link.addEventListener('click', () => {
          if (isMenuOpen) toggleMenu();
        });
      });

      // --- Page Animations ---
      const hasVisited = sessionStorage.getItem('hasVisited');

      if (hasVisited) {
        // Subsequent visits: Show immediately, no navbar stagger
        gsap.set('body', { opacity: 1 });
      } else {
        // First visit: Play intro animations
        sessionStorage.setItem('hasVisited', 'true');

        // Global Page Fade In
        gsap.to('body', { opacity: 1, duration: 0.5, ease: 'power2.inOut' });

        // Navbar Stagger (Desktop)
        const navLinks = document.querySelectorAll('nav ul.hidden li'); // Only target desktop links
        if (window.innerWidth >= 768) {
          // Only animate on desktop to avoid weirdness
          gsap.from(navLinks, {
            y: -20,
            opacity: 0,
            duration: 0.8,
            stagger: 0.1,
            ease: 'power3.out',
            delay: 0.2,
          });
        }
      }
    </script>
  </body>
</html>
